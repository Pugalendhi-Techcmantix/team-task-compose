# --- Server ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
# HOST=0.0.0.0

# Comma-separated list of allowed frontend origins. "*" is rejected in production.
CORS_ORIGIN=http://localhost:3001

# --- Redis (Laravel publishes, this service subscribes) --------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
# REDIS_TLS=false
# REDIS_DB=0
# REDIS_RECONNECT_MAX_DELAY_MS=5000

REDIS_TASK_CHANNEL=task.events
# Leave empty to disable the chat channel.
REDIS_CHAT_CHANNEL=chat.events

# --- Realtime credential issued by Laravel ---------------------------------
# HS256/HS384/HS512 need REALTIME_TOKEN_SECRET (>= 32 chars, shared with Laravel).
# RS*/ES* need REALTIME_TOKEN_PUBLIC_KEY (PEM; "\n" escapes are accepted).
# REALTIME_TOKEN_ALGORITHM=HS256
REALTIME_TOKEN_SECRET=
# REALTIME_TOKEN_PUBLIC_KEY=
REALTIME_TOKEN_ISSUER=taskflow
REALTIME_TOKEN_AUDIENCE=realtime-service
# REALTIME_TOKEN_USER_CLAIM=sub
# REALTIME_TOKEN_CLOCK_TOLERANCE_SEC=5

# --- Laravel internal API (membership checks + message storage) ------------
# In Docker Compose use the service name, e.g. http://laravel:8000/api/v1
LARAVEL_API_URL=
# Shared secret (>= 32 chars) sent as "Authorization: Bearer ..." on every call.
LARAVEL_SERVICE_TOKEN=
# LARAVEL_API_TIMEOUT_MS=3000
# LARAVEL_MEMBERSHIP_PATH=/internal/conversations/{conversationId}/members/{userId}
# LARAVEL_MESSAGES_PATH=/internal/conversations/{conversationId}/messages

# Who decides conversation access (default: laravel if LARAVEL_API_URL is set, else deny-all)
#   laravel       ask Laravel on conversation:join (fails closed)
#   deny-all      refuse every join
#   allow-all-dev any authenticated user may join; rejected when NODE_ENV=production
# CONVERSATION_AUTHORIZATION_MODE=laravel

# Where chat messages are stored (default: laravel if LARAVEL_API_URL is set, else realtime-only)
#   laravel       POST to Laravel first; broadcast only after it is saved
#   realtime-only deliver live without storing (development only)
# MESSAGE_PERSISTENCE_MODE=laravel

# --- Limits -----------------------------------------------------------------
# CHAT_MAX_MESSAGE_LENGTH=2000
# SOCKET_MAX_PAYLOAD_BYTES=16384
# EVENT_DEDUPE_TTL_MS=600000
# RATE_LIMIT_WINDOW_MS=10000
# RATE_LIMIT_CHAT_SEND=20
# RATE_LIMIT_TYPING=30
# RATE_LIMIT_CONVERSATION_JOIN=30
# SHUTDOWN_TIMEOUT_MS=10000

LOG_LEVEL=info
