# Settings for the root docker-compose.yml. Copy to .env (git-ignored) and fill in the secrets.
# Generate a secret:   openssl rand -hex 32
# Generate APP_KEY:    echo "base64:$(openssl rand -base64 32)"

APP_NAME=TaskFlow

# --- Where people open the app ---------------------------------------------
FRONTEND_PORT=6001
APP_URL=http://localhost:6001
# Every host:port used in the browser (add your LAN IP), or cookie sign-in fails.
SANCTUM_STATEFUL_DOMAINS=localhost:6001,127.0.0.1:6001,192.168.1.222:6001
CORS_ALLOWED_ORIGINS=http://localhost:6001,http://192.168.1.222:6001

# --- Laravel -----------------------------------------------------------------
APP_KEY=
RUN_SEEDERS=true
SEED_DEFAULT_PASSWORD=password
SESSION_LIFETIME=120
SANCTUM_TOKEN_EXPIRATION=1440

# --- PostgreSQL --------------------------------------------------------------
DB_DATABASE=taskflow
DB_USERNAME=taskflow
DB_PASSWORD=
# Published on 127.0.0.1 only
DB_FORWARD_PORT=5432

# --- Redis -------------------------------------------------------------------
# Laravel (full access)
REDIS_PASSWORD=
# Node.js (subscribe-only ACL user on REDIS_EVENTS_CHANNEL)
REDIS_NODE_USERNAME=taskflow_node
REDIS_NODE_PASSWORD=
REDIS_EVENTS_CHANNEL=taskflow:tasks

# --- Shared between Laravel and Node -----------------------------------------
# Signs realtime tokens (Laravel) and verifies them (Node). >= 32 chars.
REALTIME_TOKEN_SECRET=
REALTIME_TOKEN_TTL=900
# Node → Laravel internal API bearer token. >= 32 chars.
INTERNAL_SERVICE_TOKEN=

NODE_LOG_LEVEL=info
