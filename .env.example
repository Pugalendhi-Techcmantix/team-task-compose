# Settings for docker-compose.yml (copy to .env). Node's secrets go in task-node/.env.

# Host port for the app (Nginx). Never 6000: browsers block it.
FRONTEND_PORT=6001

# Where Laravel runs.
#   Laravel compose project on the same `app_network` → http://laravel:8000
#   Laravel on Dev 2's machine (LAN)                   → http://192.168.1.37:8000
LARAVEL_UPSTREAM=http://192.168.1.37:8000

# Exact browser origins allowed by the Node service (comma-separated).
CORS_ORIGIN=http://localhost:6001,http://192.168.1.222:6001

# Baked into the frontend bundle at build time (rebuild after changing).
VITE_APP_NAME=TaskFlow
VITE_API_BASE_URL=/api/v1
VITE_AUTH_MODE=cookie
