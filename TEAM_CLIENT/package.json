{
  "name": "taskflow-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "mock": "node mock/server.js",
    "dev:mock": "concurrently -k -n mock,vite -c magenta,cyan \"npm:mock\" \"vite --mode mock\"",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint ."
  },
  "dependencies": {
    "axios": "^1.21.1",
    "framer-motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.3",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "express": "^5.3.0",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "socket.io": "^4.8.4",
    "tailwindcss": "^4.3.5",
    "vite": "^8.3.8",
    "vitest": "^5.1.2"
  }
