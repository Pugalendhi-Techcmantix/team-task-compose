VITE_APP_NAME=TaskFlow
# TaskFlow Laravel API is versioned: /api/v1/...
VITE_API_BASE_URL=/api/v1
VITE_SOCKET_URL=
VITE_SOCKET_PATH=/socket.io
# cookie = Sanctum HttpOnly session (backend uses this since 2026-11-26) | token = old Bearer mode
VITE_AUTH_MODE=cookie

# Dev 2's Laravel running on their machine (LAN)
DEV_API_TARGET=http://192.168.1.37:8000
# Dev 3's Node.js Socket.IO service (LAN). The browser uses same-origin /socket.io → no CORS needed
DEV_SOCKET_TARGET=http://192.168.1.222:3000
DEV_HOST=0.0.0.0
DEV_PORT=5173

FRONTEND_PORT=6001
