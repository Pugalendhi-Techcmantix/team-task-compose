# ---- Client (baked into the build, visible in the browser) ----
VITE_APP_NAME=TaskFlow
# Laravel REST API base (versioned). Relative so Nginx / Vite proxy route it.
VITE_API_BASE_URL=/api/v1
# Socket.IO server URL. Empty = same origin (recommended, Nginx proxies /socket.io).
VITE_SOCKET_URL=
VITE_SOCKET_PATH=/socket.io
# Login mode. cookie = Sanctum HttpOnly session cookie (the backend uses this).
# token = old Bearer token in localStorage. The backend must list this site's host:port
# in SANCTUM_STATEFUL_DOMAINS (README → "Cookie auth").
VITE_AUTH_MODE=cookie

# ---- Vite dev server only (never shipped to the browser) ----
# Laravel and Node.js Socket.IO service. Use a teammate's LAN IP if they host it,
# e.g. DEV_API_TARGET=http://192.168.1.37:8000
DEV_API_TARGET=http://localhost:8000
DEV_SOCKET_TARGET=http://localhost:3000
# e.g. Dev 3's machine: DEV_SOCKET_TARGET=http://192.168.1.222:3000
# Dev server binding. true/0.0.0.0 = share on the LAN; localhost = this machine only.
DEV_HOST=0.0.0.0
DEV_PORT=5173

# ---- Docker (docker-compose.yml) ----
# Host port for the Nginx container. Avoid 6000 — browsers block it (ERR_UNSAFE_PORT).
FRONTEND_PORT=6001
